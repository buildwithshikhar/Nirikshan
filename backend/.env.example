# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Any SQLAlchemy URL; postgres:// and postgresql:// are accepted. Defaults to local SQLite if unset.
# Local Postgres from `docker compose up -d db` (host port 5433):
DATABASE_URL=postgresql://nirikshan:nirikshan@localhost:5433/nirikshan


# Case workspaces (acquired images). Default ./data
# NIRIKSHAN_DATA_DIR=./data
# Custody signing key (Ed25519, generated on first run, mode 0600). MUST be outside NIRIKSHAN_DATA_DIR.
# NIRIKSHAN_KEY_DIR=~/.nirikshan/keys

# REQUIRED for acquisition: os.pathsep-separated folders that evidence sources must live under
# (symlinks are resolved first). Empty = every acquisition is refused.
# NIRIKSHAN_EVIDENCE_ROOTS=/cases/incoming
# Block devices are refused unless set to 1 (real-disk acquisition is untested; use a write blocker).
# NIRIKSHAN_ALLOW_BLOCK_DEVICES=0
