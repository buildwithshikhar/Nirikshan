# Copy to deploy/prod.env (git-ignored) and edit. Every value is validated at startup; the backend
# refuses to start and lists what is wrong. Full reference: docs/DEPLOYMENT.md.
DATABASE_URL=sqlite:////var/lib/nirikshan/data/nirikshan.db
# Frontend origin(s), comma separated. Required in production; no '*' and no localhost.
CORS_ORIGINS=https://nirikshan.example.org
# First admin, created once at startup while no admin exists (then remove these lines).
NIRIKSHAN_FIRST_ADMIN_USERNAME=admin
NIRIKSHAN_FIRST_ADMIN_PASSWORD=change-me-to-a-long-random-password
# Public (internet-facing) instance: reference data only. Disables browser uploads and block devices.
NIRIKSHAN_PUBLIC_INSTANCE=1
# NIRIKSHAN_MAX_UPLOAD_BYTES=2147483648
# NIRIKSHAN_LOG_FORMAT=json
